{
  "manifest_version": 2,
  "id": "orxilv.mi_mai",
  "name": "Mi Mai",
  "version": "1.0.1",
  "description": "通过米家账号查看设备状态、管理设备白名单并安全控制设备与场景。",
  "author": {
    "name": "Orxil.V",
    "url": "https://github.com/hedgehogovo"
  },
  "license": "GPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/hedgehogovo/Mi-Mai"
  },
  "host_application": {
    "min_version": "1.4.5",
    "max_version": "1.4.99"
  },
  "sdk": {
    "min_version": "2.22.1",
    "max_version": "2.23.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "mijiaAPI",
      "version_spec": ">=5.0.0,<6.0.0"
    }
  ],
  "plugin_type": "tool",
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/logo.jpg",
      "fallback": "home",
      "background": "#e8f3ec"
    }
  },
  "capabilities": [
    "api.call",
    "send.text",
    "component.enable",
    "component.disable",
    "custom_pages"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
